rules_version = '2';

// ──────────────────────────────────────────────────────────────────────────────
// Firestore Security Rules — NEURAL_LINK
// ──────────────────────────────────────────────────────────────────────────────
// Deploy these rules via:
//   firebase deploy --only firestore:rules
// Or paste them directly in Firebase Console:
//   Firestore Database → Rules → Edit rules
// ──────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── students collection ───────────────────────────────────────────────────
    // Only authenticated users (faculty) can read or write student records.
    // Unauthenticated requests are rejected entirely.
    match /students/{studentId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['id', 'name', 'mark', 'status'])
                    && request.resource.data.mark is int
                    && request.resource.data.mark >= 0
                    && request.resource.data.mark <= 100;
      allow update: if request.auth != null
                    && request.resource.data.mark is int
                    && request.resource.data.mark >= 0
                    && request.resource.data.mark <= 100;
      allow delete: if request.auth != null;
    }

    // ── Deny all other collections by default ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
